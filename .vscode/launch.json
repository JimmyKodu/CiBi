{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CiBi.Browser",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "CiBi.Browser"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "App url: (https?://localhost:\\d+)",
        "uriFormat": "%s"
      }
    }
  ]
}
