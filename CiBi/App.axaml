<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CiBi.App"
             RequestedThemeVariant="Light">
             <!-- 强制 Light：app 为白底浅色风格，跟随系统(Default)时暗色主题下控件文字浅色、在白底卡片不可见 -->

    <Application.Styles>
        <FluentTheme />
        <!-- FluentTheme 控件(CheckBox/RadioButton/TextBox/Button)内容走主题字体，
             不继承根 FontFamily，中文会 tofu；这里全局钉到 Noto Sans SC -->
        <Style Selector=":is(TemplatedControl)">
            <Setter Property="FontFamily" Value="avares://CiBi/Assets/Fonts/NotoSansSC.ttf#Noto Sans SC"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://CiBi/Assets/Fonts/NotoSansSC.ttf#Noto Sans SC"/>
        </Style>
    </Application.Styles>
</Application>
